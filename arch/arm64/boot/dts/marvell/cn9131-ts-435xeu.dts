/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "cn9130.dtsi"

/ {
	model = "QNAP TS-435XeU";
	compatible = "qnap,ts-435xeu", "marvell,cn9131", "marvell,cn9130",
		     "marvell,armada-ap807-quad", "marvell,armada-ap807";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	aliases {
		gpio1 = &cp0_gpio1;
		gpio2 = &cp0_gpio2;
		gpio3 = &cp1_gpio1;
		gpio4 = &cp1_gpio2;
	};

	/* All USB buses are reguled via the same GPIO */
	usb_vbus: regulator-usb {
		compatible = "regulator-fixed";
		regulator-name = "usb-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&cp0_gpio2 8 GPIO_ACTIVE_HIGH>;
	};

	usb_phy: usb-phy {
		compatible = "usb-nop-xceiv";
		#phy-cells = <0>;
		vcc-supply = <&usb_vbus>;
	};

	sfp0: sfp-0 {
		compatible = "sff,sfp";
		i2c-bus = <&sfp0_i2c>;
	};

	sfp1: sfp-1 {
		compatible = "sff,sfp";
		i2c-bus = <&sfp1_i2c>;
	};
};

&uart0 {
	pinctrl-0 = <&uart0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&ap_sdhci0 {
	bus-width = <8>;
	status = "okay";
	mmc-ddr-1_8v;
	mmc-hs400-1_8v;
};

&cp0_syscon0 {
	cp0_pinctrl: pinctrl {
		compatible = "marvell,cp115-standalone-pinctrl";

		cp0_spi0_pins: cp0-spi-pins-0 {
			marvell,pins = "mpp13", "mpp14", "mpp15", "mpp16";
			marvell,function = "spi1";
		};

		cp0_i2c0_pins: cp0-i2c-pins-0 {
			marvell,pins = "mpp37", "mpp38";
			marvell,function = "i2c0";
		};
	};
};

&cp0_gpio1 {
	status = "okay";
};

&cp0_gpio2 {
	status = "okay";
};

&cp0_uart0 {
	status = "okay";

	mcu {
		compatible = "qnap,ts435xeu-mcu";

		fan: fan-0 {
			#cooling-cells = <2>;
			cooling-levels = <0 64 89 128 166 204 221 238>;
		};

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			serial-number@0 {
				reg = <0x0 0x13>;
			};

			ext-port@22 {
				reg = <0x22 0x2>;
			};

			mac0: macaddr@24 {
				compatible = "mac-base";
				reg = <0x24 0x11>;
				#nvmem-cell-cells = <1>;
			};

			mac1: macaddr@35 {
				compatible = "mac-base";
				reg = <0x35 0x11>;
				#nvmem-cell-cells = <1>;
			};

			mac2: macaddr@46 {
				compatible = "mac-base";
				reg = <0x46 0x11>;
				#nvmem-cell-cells = <1>;
			};

			mac3: macaddr@57 {
				compatible = "mac-base";
				reg = <0x57 0x11>;
				#nvmem-cell-cells = <1>;
			};
		};
	};
};

&cp0_spi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&cp0_spi0_pins>;
	reg = <0x700680 0x50>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <40000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "U-Boot";
				reg = <0x0 0x3e0000>;
			};

			partition@3f0000 {
				label = "U-boot Env";
				reg = <0x3f0000 0x10000>;
			};
		};
	};
};

&cp0_i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&cp0_i2c0_pins>;
	clock-frequency = <100000>;

	rtc@32 {
		compatible = "epson,rx8130";
		reg = <0x32>;
		wakeup-source;
		trickle-diode-disable;
	};

	eeprom@54 {
		compatible = "giantec,gt24c04a", "atmel,24c04";
		reg = <0x54>;
		label = "VPD_MB";
		num-addresses = <2>;
		pagesize = <16>;
		read-only;
	};

	spd@53 {
		compatible = "ee1004";
		reg = <0x53>;
	};

	i2c-mux@70 {
		compatible = "nxp,pca9543";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;

		sfp0_i2c: i2c@0 {
			reg = <0>;
		};

		sfp1_i2c: i2c@1 {
			reg = <1>;
		};
	};
};

&cp0_utmi {
	status = "okay";
};

&cp0_usb3_0 {
	status = "okay";
	usb-phy = <&usb_phy>;
	phys = <&cp0_utmi0>;
	phy-names = "utmi";
	dr_mode = "host";
};

&cp0_usb3_1 {
	status = "okay";
	phys = <&cp0_utmi1>;
	phy-names = "utmi";
	dr_mode = "host";
};

&cp0_pcie2 {
	status = "okay";
	num-viewport = <8>;
	phys = <&cp0_comphy5 2>;
};

&cp0_xmdio {
	status = "okay";

	aqr112c_0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0>;
	};

	aqr112c_8: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;
	};
};

&cp0_ethernet {
	status = "okay";
};

&cp0_eth0 {
	status = "okay";
	phys = <&cp0_comphy4 0>;
	phy-mode = "10gbase-r";
	managed = "in-band-status";
	sfp = <&sfp0>;
	nvmem-cells = <&mac2 0>;
	nvmem-cell-names = "mac-address";
};

&cp0_eth1 {
	status = "okay";
	phys = <&cp0_comphy3 1>;
	phy = <&aqr112c_0>;
	phy-mode = "2500base-x";
	nvmem-cells = <&mac0 0>;
	nvmem-cell-names = "mac-address";
};

&cp0_eth2 {
	status = "okay";
	phys = <&cp0_comphy1 2>;
	phy = <&aqr112c_8>;
	phy-mode = "2500base-x";
	nvmem-cells = <&mac1 0>;
	nvmem-cell-names = "mac-address";
};

/*
 * Instantiate the first slave CP115
 */

#define CP11X_NAME		cp1
#define CP11X_BASE		f4000000
#define CP11X_PCIEx_MEM_BASE(iface) (0xe2000000 + (iface * 0x1000000))
#define CP11X_PCIEx_MEM_SIZE(iface) 0xf00000
#define CP11X_PCIE0_BASE	f4600000
#define CP11X_PCIE1_BASE	f4620000
#define CP11X_PCIE2_BASE	f4640000

#include "armada-cp115.dtsi"

#undef CP11X_NAME
#undef CP11X_BASE
#undef CP11X_PCIEx_MEM_BASE
#undef CP11X_PCIEx_MEM_SIZE
#undef CP11X_PCIE0_BASE
#undef CP11X_PCIE1_BASE
#undef CP11X_PCIE2_BASE

&cp1_syscon0 {
	cp1_pinctrl: pinctrl {
		compatible = "marvell,cp115-standalone-pinctrl";
	};
};

&cp1_gpio1 {
	status = "okay";
};

&cp1_gpio2 {
	status = "okay";
};

&cp1_utmi {
	status = "okay";
};

&cp1_usb3_0 {
	status = "okay";
	phys = <&cp1_comphy1 0>, <&cp1_utmi0>;
	phy-names = "usb", "utmi";
	dr_mode = "host";
};

&cp1_usb3_1 {
	status = "okay";
	phys = <&cp1_comphy3 1>, <&cp1_utmi1>;
	phy-names = "usb", "utmi";
	dr_mode = "host";
};

&cp1_pcie2 {
	status = "okay";
	num-viewport = <8>;
	phys = <&cp1_comphy5 2>;
};

&cp1_ethernet {
	status = "okay";
};

&cp1_eth0 {
	status = "okay";
	phys = <&cp1_comphy4 0>;
	phy-mode = "10gbase-r";
	managed = "in-band-status";
	nvmem-cells = <&mac3 0>;
	nvmem-cell-names = "mac-address";
};
